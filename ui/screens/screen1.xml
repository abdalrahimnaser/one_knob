<screen>
	<styles>
		<style name="scr_bg" bg_color="0x000000" />
	</styles>

	<view>
		<style name="scr_bg" />

		<!-- Previous profile — dim, smaller -->
		<lv_label
			name="lbl_prev_profile"
			text="ZOOM"
			align="center"
			y="-90"
			style_text_color="0x333333"
			style_text_font="press_start_24"
		/>

		<!-- Active profile — pure white, commands attention -->
		<lv_label
			name="lbl_active_profile"
			text="VOLUME"
			align="center"
			y="0"
			style_text_color="0xFFFFFF"
			style_text_font="press_start_36"
		/>

		<!-- Next profile — dim, smaller -->
		<lv_label
			name="lbl_next_profile"
			text="SCROLL"
			align="center"
			y="90"
			style_text_color="0x333333"
			style_text_font="press_start_24"
		/>

		<!-- Separator lines — teal, structural -->
		<lv_obj width="360" height="2" align="center" y="-50" style_bg_color="0x00FFD1" style_border_width="0" />
		<lv_obj width="360" height="2" align="center" y="50" style_bg_color="0x00FFD1" style_border_width="0" />

		<!-- Hint — amber, distinct role, doesn't compete -->
		<lv_label
			text="PRESS TO SELECT"
			align="bottom_mid"
			y="-40"
			style_text_color="0xFFB300"
			style_text_font="press_start_16"
		/>
	</view>
</screen>
